name: Build APK
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 20 }
      - uses: actions/setup-java@v4
        with: { distribution: temurin, java-version: 17 }
      - run: npm install
      - name: Assemble web files
        run: |
          mkdir -p www/css/fontawesome
          npx tailwindcss -i input.css -o www/css/tailwind.css --minify
          cp node_modules/@fortawesome/fontawesome-free/css/all.min.css www/css/fontawesome/
          cp -r node_modules/@fortawesome/fontawesome-free/webfonts www/css/webfonts
          cp index.html www/index.html
      - run: npx cap add android
      - run: npx cap sync android
      - run: cd android && chmod +x gradlew && ./gradlew assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: FastCalc-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
